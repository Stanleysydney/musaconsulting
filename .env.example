MONGODB_URI=mongodb+srv://user:password@cluster.example/musaconsulting
JWT_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# Either SMTP_* or EMAIL_USER/EMAIL_PASS can be used for transactional email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@example.com
SMTP_PASS=replace-with-smtp-password
EMAIL_FROM="MusaConsulting <notifications@example.com>"
EMAIL_TO=careteam@example.com

# Legacy Gmail-style env names are supported for compatibility.
EMAIL_USER=
EMAIL_PASS=
